 src/clifft/sampling/batch/bits.h      |   6 +
 src/clifft/sampling/batch/executor.cc | 183 ++++++++++++++++++--------
 src/clifft/sampling/batch/executor.h  |   2 +-
 3 files changed, 135 insertions(+), 56 deletions(-)

diff --git a/src/clifft/sampling/batch/bits.h b/src/clifft/sampling/batch/bits.h
index 3bd59847..9af330f6 100644
--- a/src/clifft/sampling/batch/bits.h
+++ b/src/clifft/sampling/batch/bits.h
@@ -24,6 +24,12 @@ class PackedBitColumns {

     [[nodiscard]] size_t num_columns() const noexcept { return columns_; }

+    // Raw storage for hot loops that set many bits and cannot afford to
+    // re-read this object between them. Column c and lane s live at
+    // words()[c * word_capacity() + s / 64].
+    [[nodiscard]] uint64_t* words() noexcept { return words_; }
+    [[nodiscard]] size_t word_capacity() const noexcept { return word_capacity_; }
+
     [[nodiscard]] std::span<uint64_t> column(size_t column) noexcept;
     [[nodiscard]] std::span<const uint64_t> column(size_t column) const noexcept;

diff --git a/src/clifft/sampling/batch/executor.cc b/src/clifft/sampling/batch/executor.cc
index 35a38462..b182f616 100644
--- a/src/clifft/sampling/batch/executor.cc
+++ b/src/clifft/sampling/batch/executor.cc
@@ -197,54 +197,160 @@ void BatchExecutor::finalize_presampled_symbols() noexcept {
     initialize_presampled_expressions();
